+    let (response_tx, mut response_rx) = tokio::sync::mpsc::channel(1);
+    let options = AccessDialogOptions {
+        modal: Some(true),
+        deny_label: Some(labels.deny),
+        grant_label: Some(labels.grant),
+        icon: Some(labels.icon),
+        choices: None,
+    };
